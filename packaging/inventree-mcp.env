# InvenTree MCP packaged HTTP service configuration.
#
# Production HTTP startup validates protected MCP OAuth access-token envelopes,
# but live connector setup and packaged deployment remain gated follow-up work.
# Packaged installs create this secret-bearing config file with mode 0600.
INVENTREE_MCP_LISTEN=127.0.0.1:28686
INVENTREE_MCP_PATH=/mcp
INVENTREE_URL=https://inventory.example.test
INVENTREE_MCP_ENVIRONMENT=production
INVENTREE_MCP_LOG_LEVEL=info

# Generate 32-byte key material with a cryptographically secure generator such
# as `openssl rand -base64 32`. Keep exactly one active key. See the operator
# recipe for normal rotation, retirement, and compromise response.
# INVENTREE_MCP_OAUTH_ISSUER_URL=https://mcp.example.test
# INVENTREE_MCP_OAUTH_RESOURCE_URL=https://mcp.example.test/mcp
# INVENTREE_MCP_OAUTH_KEYS=current:active:REPLACE_WITH_BASE64_32_BYTE_KEY
# INVENTREE_MCP_OAUTH_CLIENT_IDS=https://chatgpt.com/client-metadata/REPLACE_ME
# Same-host reverse proxy example. Use only the narrow CIDRs of proxies that
# can connect to INVENTREE_MCP_LISTEN; do not copy private-network supernets.
# INVENTREE_MCP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Development-only HTTP smoke-test settings. Do not enable the packaged service
# for a live connector until setup and deployment validation are complete.
# INVENTREE_MCP_ENVIRONMENT=development
# INVENTREE_MCP_DEV_INCOMPLETE_OAUTH=true
