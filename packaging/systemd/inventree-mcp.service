[Unit]
Description=InvenTree MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
Restart=on-failure
RestartSec=5s
ExecStart=/usr/bin/inventree-mcp serve --config /etc/inventree-mcp/config.yml
TimeoutSec=60

[Install]
WantedBy=multi-user.target
